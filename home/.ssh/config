# SSH client config. Keys auto-add to the systemd ssh-agent socket on first use.
Host *
	AddKeysToAgent yes
	IdentitiesOnly no
	ServerAliveInterval 60
	ServerAliveCountMax 3
	# Never forward the agent unless explicitly requested per-host
	ForwardAgent no

Host github.com
	HostName github.com
	User git
	IdentityFile ~/.ssh/id_ed25519
	IdentitiesOnly yes

Host gitlab.com
	HostName gitlab.com
	User git
	IdentityFile ~/.ssh/id_ed25519
	IdentitiesOnly yes
